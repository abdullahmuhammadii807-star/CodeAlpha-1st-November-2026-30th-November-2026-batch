
# TASK 2: Stock Portfolio Tracker

# Dictionary of stock prices
stock_prices = {
    "AAPL": 180,
    "TSLA": 250,
    "GOOGL": 140,
    "MSFT": 420,
    "AMZN": 190
}

portfolio = {}
total_investment = 0

print("===== STOCK PORTFOLIO TRACKER =====")

# Display available stocks
print("\nAvailable Stocks:")
for stock, price in stock_prices.items():
    print(stock, "=", "$", price)

# Get user input
while True:
    name = input("\nEnter stock name (or done to finish): ").upper()

    if name == "DONE":
        break

    if name not in stock_prices:
        print("Stock not available!")
        continue

    quantity = input("Enter quantity: ")

    if not quantity.isdigit() or int(quantity) <= 0:
        print("Enter a valid positive quantity!")
        continue

    quantity = int(quantity)

    portfolio[name] = portfolio.get(name, 0) + quantity

# Calculate investment
print("\n===== PORTFOLIO SUMMARY =====")

for stock, quantity in portfolio.items():
    price = stock_prices[stock]
    investment = price * quantity

    total_investment += investment

    print(stock, "Quantity:", quantity,
          "Investment: $", investment)

print("\nTotal Investment: $", total_investment)

# Save portfolio in a text file
with open("portfolio.txt", "w") as file:
    file.write("STOCK PORTFOLIO SUMMARY\n")

    for stock, quantity in portfolio.items():
        investment = stock_prices[stock] * quantity
        file.write(f"{stock}: {quantity} shares = ${investment}\n")

    file.write(f"\nTotal Investment: ${total_investment}")

print("\nPortfolio saved successfully!")
